{
  "id": "writing-group-notice",
  "category": "writing",
  "description": "写一条 150 字内、不用 Markdown 的小区微信群停水通知",
  "turns": [
    {
      "prompt": "帮我写一条发到小区业主微信群的通知：本周六（10月11日）上午 9 点到下午 3 点，因为水管维修，3 号楼和 5 号楼停水。提醒大家提前储水，有问题联系物业电话 6688-1234。要简短，150 字以内，不要用 Markdown 格式。"
    }
  ],
  "limits": {
    "maxTurns": 6,
    "timeoutSec": 180,
    "budgetTokens": 150000
  },
  "graders": [
    {
      "id": "facts",
      "type": "reply_contains",
      "all": [
        [
          "10月11日",
          "10月11号"
        ],
        [
          "9点",
          "9:00",
          "九点",
          "9时"
        ],
        [
          "下午3点",
          "下午3:00",
          "15:00",
          "下午三点",
          "15点",
          "下午3时"
        ],
        "3号",
        "5号",
        "储水",
        "6688-1234"
      ]
    },
    {
      "id": "short",
      "type": "reply_length",
      "max": 160
    },
    {
      "id": "no-markdown",
      "type": "reply_not_matches",
      "pattern": "^\\s*#{1,6}\\s|\\*\\*",
      "flags": "m"
    },
    {
      "id": "chinese",
      "type": "reply_zh"
    },
    {
      "id": "judge",
      "type": "llm_judge",
      "minScore": 4,
      "rubric": "1. 是否包含时间（10月11日周六 9:00–15:00）、范围（3号楼和5号楼）、原因（水管维修）、提醒储水和物业电话 6688-1234；\n2. 是否简短（150 字以内）、没有 Markdown 符号，适合直接粘贴到微信群；\n3. 语气是否礼貌、清楚，普通居民一眼能看懂。"
    }
  ],
  "mock": {
    "pass": {
      "turns": [
        [
          {
            "say": "【停水通知】各位业主好！本周六（10月11日）上午9点到下午3点，因水管维修，3号楼和5号楼将暂停供水。请大家提前储水，做好准备。如有问题请联系物业：6688-1234。给大家带来不便，敬请谅解！"
          }
        ]
      ]
    },
    "fail": {
      "expectFail": [
        "facts",
        "no-markdown"
      ],
      "turns": [
        [
          {
            "say": "## 停水通知\n\n- **时间**：本周六上午 9 点到下午 3 点\n- **范围**：3号楼、5号楼\n\n请大家提前储水。"
          }
        ]
      ]
    }
  }
}
