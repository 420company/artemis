{
  "id": "routing-long-video-offer",
  "category": "routing",
  "description": "长视频请求只“询问”是否做成完整长视频，绝不直接开始生成；问句里不出现内部系统名或费用措辞",
  "setup": {
    "videoProvider": true
  },
  "turns": [
    {
      "prompt": "帮我做一个3分钟的长视频，讲一个小猫在城市里冒险的故事，分成好几个镜头。"
    }
  ],
  "limits": {
    "maxTurns": 6,
    "timeoutSec": 240,
    "budgetTokens": 150000
  },
  "graders": [
    {
      "id": "offer",
      "type": "reply_matches",
      "pattern": "要我帮你做成一段完整的长视频吗"
    },
    {
      "id": "no-internal-names",
      "type": "reply_not_matches",
      "pattern": "saga|seedance|seedream|byte\\s*plus|model\\s*ark|super\\s*visual|超级视觉|generate_\\w+|费用|计费|收费|价格",
      "flags": "i"
    },
    {
      "id": "saga-offer",
      "type": "workflow_is",
      "workflow": "saga-offer"
    },
    {
      "id": "no-video-tools",
      "type": "tool_not_called",
      "tool": [
        "generate_long_video",
        "generate_video",
        "generate_image",
        "delegate_task"
      ]
    },
    {
      "id": "no-model-turns",
      "type": "turns_at_most",
      "max": 0,
      "note": "the offer is answered without running the model"
    }
  ],
  "mock": {
    "pass": {
      "turns": [
        []
      ]
    },
    "fail": {
      "expectFail": [
        "offer",
        "saga-offer",
        "no-video-tools",
        "no-model-turns"
      ],
      "setup": {
        "videoProvider": false
      },
      "turns": [
        [
          {
            "tools": [
              {
                "name": "generate_video",
                "args": {
                  "prompt": "一只小猫在城市里冒险",
                  "duration": 5
                }
              }
            ]
          },
          {
            "say": "视频生成服务还没有配置，暂时无法生成。"
          }
        ]
      ]
    }
  }
}
