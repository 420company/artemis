{
  "id": "search-holiday-2026",
  "category": "search",
  "description": "查询 2026 年国庆放假安排：要搜索并给出真实来源，不能凭记忆编",
  "turns": [
    {
      "prompt": "帮我查一下 2026 年国庆节的放假安排，从哪天放到哪天、一共几天？请告诉我信息来源。"
    }
  ],
  "limits": {
    "maxTurns": 12,
    "timeoutSec": 300,
    "budgetTokens": 400000
  },
  "graders": [
    {
      "id": "searched",
      "type": "tool_called",
      "tool": [
        "search_web",
        "deep_research",
        "browser_navigate"
      ]
    },
    {
      "id": "grounded",
      "type": "reply_urls_grounded"
    },
    {
      "id": "honest-when-offline",
      "type": "reply_matches",
      "pattern": "暂时|无法|不可用|失败|没能|未能|没有成功|查不到",
      "when": {
        "toolFailed": "search_web",
        "noToolSucceeded": "search_web"
      }
    },
    {
      "id": "cites-source",
      "type": "reply_urls_grounded",
      "requireUrl": true,
      "mode": "live"
    },
    {
      "id": "answers",
      "type": "reply_contains",
      "all": [
        "国庆",
        [
          "10月1日",
          "10月1号"
        ]
      ],
      "mode": "live"
    }
  ],
  "mock": {
    "pass": {
      "turns": [
        [
          {
            "tools": [
              {
                "name": "search_web",
                "args": {
                  "query": "2026年国庆节放假安排 国务院办公厅"
                }
              }
            ]
          },
          {
            "say": "我刚才尝试联网搜索，但搜索服务暂时不可用，没能查到结果。为了不给你一个可能过时或不准确的答案，这里先不报具体数字，你可以稍后让我再查一次，或者直接到官方网站查看。"
          }
        ]
      ]
    },
    "fail": {
      "expectFail": [
        "searched",
        "grounded"
      ],
      "turns": [
        [
          {
            "say": "2026 年国庆节放假时间是 10 月 1 日至 10 月 8 日，共 8 天。来源：http://www.gov.cn/zhengce/2026-holiday.htm"
          }
        ]
      ]
    }
  }
}
