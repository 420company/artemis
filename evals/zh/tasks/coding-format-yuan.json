                "name": "write_file",
                "args": {
                  "path": "utils.js",
                  "content": "// 金额相关的小工具。\n\n/**\n * 把数字格式化成人民币金额字符串：¥ 符号、千位分隔符、保留两位小数，负数把负号放在最前面。\n * 例如 1234.5 → \"¥1,234.50\"，-56.789 → \"-¥56.79\"。\n */\nfunction formatYuan(amount) {\n  const sign = amount < 0 ? '-' : ''\n  const [integer, decimals] = Math.abs(amount).toFixed(2).split('.')\n  return `${sign}¥${integer.replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',')}.${decimals}`\n}\n\nmodule.exports = { formatYuan }\n"
