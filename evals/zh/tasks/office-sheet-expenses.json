                            "header": "日期",
                            "format": "date"
                          },
                          {
                            "header": "类别"
                          },
                          {
                            "header": "金额",
                            "format": "cny"
                          }
                        ],
                        "rows": [
                          [
                            "2026-09-01",
                            "餐饮",
                            320
                          ],
                          [
                            "2026-09-03",
