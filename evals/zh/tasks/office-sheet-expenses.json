                          [
                            "2026-09-26",
                            "日用",
                            754
                          ],
                          [
                            {
                              "value": "合计",
                              "bold": true
                            },
                            null,
                            "=SUM(C2:C9)"
                          ]
                        ],
                        "autoFilter": true
