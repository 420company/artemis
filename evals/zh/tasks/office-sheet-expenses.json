{
  "id": "office-sheet-expenses",
  "category": "office",
  "description": "把开支 CSV 整理成 Excel：明细、公式合计（数值要对）、按类别汇总的饼图",
  "fixture": "office-sheet-expenses",
  "turns": [
    {
      "prompt": "开支.csv 是我家九月的开支，帮我整理成 Excel：按日期列出明细，最后一行用公式算合计，再加一个按类别汇总的饼图。"
    }
  ],
  "limits": {
    "maxTurns": 16,
    "timeoutSec": 420,
    "budgetTokens": 600000
  },
  "graders": [
    {
      "id": "workbook",
      "type": "office_file",
      "pattern": "\\.xlsx$",
      "kind": "xlsx",
      "contains": [
        "合计",
        "餐饮"
      ],
      "minFormulas": 1,
      "numbers": [
        3280
      ],
      "minCharts": 1
    },
    {
      "id": "made-with-tool",
      "type": "tool_called",
      "tool": "create_spreadsheet",
      "ok": true
    },
    {
      "id": "source-untouched",
      "type": "files_unchanged",
      "paths": [
        "开支.csv"
      ]
    },
    {
      "id": "total-in-reply",
      "type": "reply_contains",
      "all": [
        [
          "3280",
          "3,280"
        ]
      ]
    },
    {
      "id": "chinese",
      "type": "reply_zh"
    }
  ],
  "mock": {
    "pass": {
      "turns": [
        [
          {
            "tools": [
              {
                "name": "read_file",
                "args": {
                  "path": "开支.csv"
                }
              }
            ]
          },
          {
            "tools": [
              {
                "name": "create_spreadsheet",
                "args": {
                  "path": "outputs/九月开支.xlsx",
                  "spec": {
                    "theme": "minimal",
                    "sheets": [
                      {
                        "name": "九月明细",
